utor_principal":false},{"id":"2467670","tp":"PEC","n":"42","a":"2024","e":"Acrescenta o inciso VI ao art. 51 da Constituição Federal, para estabelecer competência privativa à Câmara dos Deputados relativa à fiscalização das atividades das agências reguladoras.","d":"2024-11-11","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2467618","tp":"PL","n":"4297","a":"2024","e":"Altera-se a Lei nº 11.460, de 21 de março de 2007 para dispor sobre plantio de organismos geneticamente modificados.","d":"2024-11-07","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2448752","tp":"PEC","n":"29","a":"2024","e":"Altera a Constituição Federal para acrescentar no art. 5º texto sobre o marco temporal de início da vida humana explicitando de forma inequívoca a inviolabilidade do direito à vida, desde a sua concepção, bem como cria o inciso LXXX para especificar que a concepção é a junção do gameta masculino e o feminino, ocorrida durante a fecundação, em local propício para o desenvolvimento celular.","d":"2024-07-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2447265","tp":"PEC","n":"27","a":"2024","e":"Altera a Constituição Federal para acrescentar o Capítulo IX - Da Promoção Da Igualdade Racial, que institui o Fundo Nacional de Reparação Econômica e de Promoção da Igualdade Racial (FNREPIR) com o objetivo de promover a igualdade de oportunidades e a inclusão social dos brasileiros pretos e pardos, e dá outras providências","d":"2024-07-08","s":"Encerramentos","autor_principal":false},{"id":"2435230","tp":"PL","n":"1968","a":"2024","e":"Dispõe sobre a prorrogação do prazo da entrega da declaração de ajuste do imposto de renda no ano de 2024, referente ao ano fiscal de 2023, para os residentes do Estado do Rio Grande do Sul","d":"2024-05-21","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Análise)","autor_principal":false},{"id":"2435228","tp":"PL","n":"1966","a":"