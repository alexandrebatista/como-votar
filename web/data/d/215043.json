{"id":215043,"nome":"Josivaldo JP","partido":"UNIÃO","uf":"MA","foto":"https://www.camara.leg.br/internet/deputado/bandep/215043.jpg","inicio":"2023-02-01","fim":"2026-09-03","meses":40,"em_exercicio":true,"periodos":[["2023-02-01","2026-09-03"]],"ideologia":{"nota":8.34,"faixa":"direita","campo":"direita","estimado":true,"obs":"partido criado em 2022; média das notas de PSL (8,11) e DEM (8,57), que se fundiram"},"ideologia_voto":{"nota":6.24,"faixa":"centro-direita","campo":"direita","n":147},"candidatura":{"cargo":"Deputado Federal","uf":"MA","partido":"UNIÃO","numero":"4411","nome_urna":"Josivaldo Jp","reeleicao":true,"cruzamento":"exato","outros_registros":[],"substituidos":[]},"candidatura_substituida":null,"partido_voto":{"nota":5.93,"faixa":"centro-direita","n":57,"q1":5.41,"q3":6.69},"propostas":{"contagem":{"REQ":158,"EMC":34,"PEC":19,"PL":11,"EMP":10,"REC":5,"RCP":4,"PRL":4,"PDL":3,"PLP":3,"RPD":2,"SLD":2,"INC":1,"SBT":1},"lista":[{"id":"2644800","tp":"PEC","n":"16","a":"2026","e":"Acrescenta os art. 68-A no Ato das Disposições Constitucionais Transitórias para ratificar os registros de imóveis rurais em faixa de fronteira concedidos pelos estados antes da promulgação desta Constituição Federal e dá outras providências.","d":"2026-08-28","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2634838","tp":"PL","n":"3267","a":"2026","e":"Institui a Política Nacional de Apoio ao Desenvolvimento Integral de Crianças e Adolescentes Neurodivergentes, cria o Fundo Nacional de Apoio ao Desenvolvimento Integral de Crianças e Adolescentes Neurodivergentes – FUNADINCA, estabelece critérios de prioridade com base no Cadastro Único para Programas Sociais do Governo Federal, e dá outras providências.","d":"2026-06-23","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2634836","tp":"PL","n":"3266","a":"2026","e":"Dispõe sobre a disponibilização e utilização de aparelhos de medição de glicose capilar em operações de fiscalização de trânsito e dá outras providências.","d":"2026-06-23","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2633488","tp":"PEC","n":"15","a":"2026","e":"Altera os art. 150 Constituição Federal para incluir as entidades esportivas sem fins lucrativos.","d":"2026-06-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2623400","tp":"PEC","n":"8","a":"2026","e":"Altera o art. 228 da Constituição Federal para admitir, em caráter excepcional, a redução da maioridade penal em casos de crimes hediondos e de crueldade extrema contra pessoas e animais.","d":"2026-05-11","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2604173","tp":"PEC","n":"3","a":"2026","e":"Altera o art. 155 da Constituição Federal para estabelecer alíquota máxima e base de cálculo exclusiva do Imposto sobre a Propriedade de Veículos Automotores – IPVA, e acrescenta dispositivos ao Ato das Disposições Constitucionais Transitórias para limitar despesas com publicidade institucional e com o Poder Legislativo.","d":"2026-02-24","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2588979","tp":"PL","n":"5987","a":"2025","e":"Acrescenta dispositivo na Lei nº 8.036, de 11 de maio de 1990, que dispõe sobre o Fundo de Garantia do Tempo de Serviço, e dá outras providências.","d":"2025-11-26","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2588977","tp":"PL","n":"5986","a":"2025","e":"Altera a Lei nº 9.503, de 23 de setembro de 1997, que institui o Código de Trânsito Brasileiro (CTB), para dispor sobre a sinalização horizontal de faixas de pedestres em locais dotados de semáforos.","d":"2025-11-26","s":"Aguardando Parecer","autor_principal":true},{"id":"2578996","tp":"PEC","n":"40","a":"2025","e":"Altera o Art. 7° da Constituição Federal para prever a possibilidade de opção pelos empregados quanto à jornada de trabalho, podendo escolher entre o regime comum previsto pela Consolidação das Leis do Trabalho (CLT), ou um regime flexível baseado em horas trabalhadas.","d":"2025-10-29","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2576168","tp":"PEC","n":"38","a":"2025","e":"Altera normas sobre a Administração Pública brasileira para aperfeiçoar a governança e a gestão pública, promover a transformação digital, impulsionar a profissionalização e extinguir privilégios no serviço público.","d":"2025-10-24","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2551011","tp":"PEC","n":"32","a":"2025","e":"Esta Lei altera o artigo 5º, inciso XLIII, da Constituição Federal, o qual prevê que nos casos de crimes previstos neste inciso, a pena deverá ser cumprida integralmente em regime fechado, por eles respondendo os mandantes, os executores e os que, podendo evitá-los, se omitirem, e dá outras providências.","d":"2025-08-20","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2529267","tp":"PLP","n":"141","a":"2025","e":"Institui a Região Carajás-São Luís, para efeitos administrativos, em um mesmo complexo geoeconômico, social e cultural; visando ao desenvolvimento e à redução das desigualdades regionais, em conformidade com o artigo 43 da Constituição Federal.","d":"2025-06-30","s":"Aguardando Parecer","autor_principal":true},{"id":"2527743","tp":"PDL","n":"346","a":"2025","e":"Susta os efeitos da Resolução nº 265, de 12 de junho de 2025, do Conselho Nacional dos Direitos da Criança e do Adolescente (CONANDA), que estabelece diretrizes para o enfrentamento das violências sexuais contra crianças e adolescentes, por extrapolar os limites da competência regulamentar e contrariar preceitos constitucionais e legais.","d":"2025-06-24","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2516755","tp":"PLP","n":"125","a":"2025","e":"Altera dispositivos da Lei Complementar nº 123 de 14 de dezembro de 2006, que “Institui o Estatuto Nacional da Microempresa e da Empresa de Pequeno Porte\" estabelecendo correção anual do faturamento MEI pelo INPC.","d":"2025-05-26","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2516738","tp":"PL","n":"2558","a":"2025","e":"Altera dispositivos da Consolidação das Leis do Trabalho no que se refere à licença maternidade, suspendendo a contagem do prazo da licença-maternidade quando a criança necessitar de internação hospitalar, na forma que especifica.","d":"2025-05-26","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2482788","tp":"PDL","n":"61","a":"2025","e":"Susta o Decreto nº 12.373, de 31 de Janeiro de 2025, que Regulamenta o exercício do poder de polícia da Fundação Nacional dos Povos Indígenas, nos termos do art. 49, V da Constituição Federal.","d":"2025-02-04","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2479738","tp":"PEC","n":"51","a":"2024","e":"Altera o art. 7º e o Ato das Disposições Constitucionais Transitórias da Constituição Federal de 1988, para dispor sobre as condições especiais de trabalho do motorista profissional empregado no transporte rodoviário de cargas e de passageiros.","d":"2024-12-12","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2477791","tp":"PL","n":"4791","a":"2024","e":"Institui isenção de Imposto de Importação a doações de bens hospitalares e medicamentos destinados a hospitais da Rede Pública de Saúde.","d":"2024-12-10","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2458742","tp":"PEC","n":"34","a":"2024","e":"Inclui a primeira infância como beneficiária de direitos e garantias, no Texto Constitucional.","d":"2024-09-19","s":"Apresentação de Requerimento","autor_principal":false},{"id":"2448752","tp":"PEC","n":"29","a":"2024","e":"Altera a Constituição Federal para acrescentar no art. 5º texto sobre o marco temporal de início da vida humana explicitando de forma inequívoca a inviolabilidade do direito à vida, desde a sua concepção, bem como cria o inciso LXXX para especificar que a concepção é a junção do gameta masculino e o feminino, ocorrida durante a fecundação, em local propício para o desenvolvimento celular.","d":"2024-07-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2447265","tp":"PEC","n":"27","a":"2024","e":"Altera a Constituição Federal para acrescentar o Capítulo IX - Da Promoção Da Igualdade Racial, que institui o Fundo Nacional de Reparação Econômica e de Promoção da Igualdade Racial (FNREPIR) com o objetivo de promover a igualdade de oportunidades e a inclusão social dos brasileiros pretos e pardos, e dá outras providências","d":"2024-07-08","s":"Encerramentos","autor_principal":false},{"id":"2442880","tp":"PEC","n":"24","a":"2024","e":"Altera os §§ 4º, 4°-B e 7º do art. 40 da Constituição Federal e os artigos 5º, 10, 23, 24 e 26 da Emenda Constitucional nº 103, de 2019, acrescenta o art. 144-A a Constituição e dá outras providências.","d":"2024-06-24","s":"Aguardando Constituição de Comissão Temporária","autor_principal":false},{"id":"2436224","tp":"PEC","n":"21","a":"2024","e":"Altera o art. 198 da Constituição Federal, para promover o enquadramento dos servidores públicos federais ocupantes do cargo de auxiliar de enfermagem para a carreira dos técnicos de enfermagem.","d":"2024-05-23","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2429195","tp":"PL","n":"1406","a":"2024","e":"Altera a Lei nº 12.187, de 29 de dezembro de 2009, para aprimorar o texto legislativo, que institui a Política Nacional sobre Mudança do Clima - PNMC, incluindo disposições sobre a não aceitação de acordos internacionais que possam representar restrições discriminatórias ao comércio internacional de produtos brasileiros.","d":"2024-04-23","s":"Pronta para Pauta","autor_principal":false},{"id":"2424910","tp":"PL","n":"1129","a":"2024","e":"Altera a Lei nº 9.991, de 24 de julho de 2000, que dispõe sobre realização de investimentos em pesquisa e desenvolvimento e em eficiência energética por parte das empresas concessionárias, permissionárias e autorizadas do setor de energia elétrica, e dá outras providências, para dispor sobre incentivos a projetos de geração distribuída em escolas e instituições de ensino públicas.","d":"2024-04-08","s":"Notificações","autor_principal":true},{"id":"2424907","tp":"PL","n":"1128","a":"2024","e":"Dispõe sobre a instalação de sistema de microgeração ou minigeração distribuída de energia elétrica na construção de novas salas de aula de escolas e instituições de ensino públicas.","d":"2024-04-08","s":"Notificações","autor_principal":true},{"id":"2408374","tp":"PL","n":"5791","a":"2023","e":"Dispõe sobre a religação de unidade consumidora, em especial do Microempreendedor Individual (MEI), da Microempresa e Empresa de Pequeno Porte (MPE), que teve o fornecimento de Energia Elétrica suspenso por inadimplência momentânea, na forma do regulamento.","d":"2023-11-29","s":"Retirado pelo(a) Autor(a)","autor_principal":true},{"id":"2402861","tp":"PEC","n":"57","a":"2023","e":"Altera os arts. 40 e 144 da Constituição Federal para dispor sobre as Polícias Municipais.","d":"2023-11-08","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2391567","tp":"PEC","n":"50","a":"2023","e":"Altera o art. 49 da Constituição Federal para estabelecer competência ao Congresso Nacional para sustar, por maioria qualificada dos membros da Câmara dos Deputados e do Senado Federal, decisão do Supremo Tribunal Federal transitada em julgado, que extrapole os limites constitucionais.","d":"2023-09-27","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2388029","tp":"PEC","n":"44","a":"2023","e":"Adiciona-se parágrafo 9ºB ao artigo 166 da Constituição Federal para permitir o emendamento em reserva, de 5% para o uso em catástrofes e emergências naturais.\n\n\n\r\n\r\nNOVA EMENTA: Altera o art. 166 da Constituição Federal e acrescenta o art. 138 no Ato das Disposições Constitucionais Transitórias, para destinar parte dos recursos das emendas individuais e de bancadas estaduais e do orçamento da Uni","d":"2023-09-14","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2380340","tp":"PEC","n":"38","a":"2023","e":"Modifica as regras dos regimes próprios de previdência social dos servidores dos municípios, objetivando o equilíbrio financeiro e atuarial dos regimes e a sustentabilidade fiscal desses entes, e dá outras providências.","d":"2023-08-16","s":"Aguardando Designação - Aguardando Devolução de Relator(a) que deixou de ser Membro","autor_principal":false},{"id":"2377463","tp":"PEC","n":"34","a":"2023","e":"Inclui dispositivos nos artigos 3º e 5º da Constituição da República Federativa do Brasil, estabelecendo o combate às drogas ilícitas como princípio fundamental e vedando expressamente a descriminalização do tráfico e a legalização de novas drogas recreativas.","d":"2023-08-09","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2375447","tp":"PDL","n":"209","a":"2023","e":"Susta os efeitos da Resolução nº 510, de 26 de junho de 2023, do Conselho Nacional de Justiça, que “regulamenta a criação, no âmbito do Conselho Nacional de Justiça e dos Tribunais, respectivamente, da Comissão Nacional de Soluções Fundiárias e das Comissões Regionais de Soluções Fundiárias, institui diretrizes para a realização de visitas técnicas nas áreas objeto de litígio possessório e estabel","d":"2023-08-03","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2372339","tp":"PL","n":"3361","a":"2023","e":"Acrescenta o art. 26-I à Lei n° 8.080, de 19 de  setembro de 1990, para dispor sobre a  destinação de estrutura tecnológica e de  espaço físico nas Unidades Básicas de  Saúde (UBSs), e nas Unidades de Pronto  Atendimento (UPAs), para o exercício profissional da telessaúde.","d":"2023-07-04","s":"Aguardando Parecer","autor_principal":true},{"id":"2365139","tp":"PLP","n":"125","a":"2023","e":"Altera a Lei Complementar nº 123, de 14 de dezembro de 2006, a Lei nº 12.592, de 18 de janeiro de 2012, a Lei Complementar nº 116, de 31 de julho de 2003, e dá outras providências. Altera o Decreto-Lei nº 5.452, de 1º de maio de 1943 (Consolidação das Leis do Trabalho – CLT), a Lei nº 8.213, de 24 de julho de 1991, a Lei nº 7.418, de 16 de dezembro de 1985, a Lei nº 9.430, de 27 de dezembro de 199","d":"2023-05-24","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2351506","tp":"PEC","n":"5","a":"2023","e":"Acrescenta § 4º-A ao art. 150 da Constituição Federal, para dispor sobre a imunidade tributária de que tratam as suas alíneas “b” e “c” do inciso VI.","d":"2023-03-15","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false}]},"votos":{"lista":[[5,"N","N","PSD","L"],[6,"N","N","PSD","L"],[7,"S","S","PSD","S"],[8,"S","S","PSD","S"],[9,"S","S","PSD","S"],[10,"S","S","PSD","S"],[11,"S","S","PSD","S"],[12,"N","S","PSD","S"],[14,"S","S","PSD","S"],[15,"S","S","PSD","S"],[17,"N","N","PSD","N"],[20,"S","S","PSD","L"],[21,"S","S","PSD","S"],[25,"N","N","PSD","N"],[26,"S","S","PSD","S"],[28,"S","S","PSD","S"],[31,"N","N","PSD","L"],[32,"N","N","PSD","L"],[33,"N","N","PSD","L"],[34,"S","S","PSD","L"],[35,"S","S","PSD","S"],[36,"N","N","PSD","N"],[37,"S","S","PSD","S"],[38,"S","S","PSD","S"],[39,"N","N","PSD","N"],[40,"S","S","PSD","S"],[41,"N","N","PSD","N"],[42,"S","S","PSD","S"],[43,"N","S","PSD","L"],[44,"S","S","PSD","S"],[45,"N","N","PSD","N"],[46,"S","S","PSD","S"],[47,"N","N","PSD","N"],[48,"N","N","PSD","N"],[49,"S","S","PSD","S"],[50,"S","S","PSD","L"],[51,"S","S","PSD","L"],[52,"S","S","PSD","S"],[53,"N","N","PSD","N"],[54,"S","S","PSD","S"],[55,"S","S","PSD","S"],[56,"S","S","PSD","S"],[59,"S","N","PSD","L"],[60,"S","S","PSD","