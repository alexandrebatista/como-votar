{"id":92776,"nome":"Stefano Aguiar","partido":"PSD","uf":"MG","foto":"https://www.camara.leg.br/internet/deputado/bandep/92776.jpg","inicio":"2023-01-09","fim":"2026-09-02","meses":41,"em_exercicio":true,"ideologia":{"nota":7.09,"faixa":"direita","campo":"direita","estimado":false,"obs":""},"ideologia_voto":{"nota":6.13,"faixa":"centro-direita","campo":"direita","n":134},"candidatura":{"cargo":"Deputado Federal","uf":"MG","partido":"PSD","numero":"5544","nome_urna":"Stefano Aguiar","reeleicao":true,"cruzamento":"exato"},"partido_voto":{"nota":5.05,"faixa":"centro","n":54,"q1":4.23,"q3":5.81},"propostas":{"contagem":{"REQ":103,"PEC":29,"EMC":12,"PL":8,"RCP":7,"RPD":6,"INC":4,"EMP":4,"PDL":2,"PRL":2,"REC":2,"SOR":1,"EMA":1,"VTS":1},"lista":[{"id":"2633488","tp":"PEC","n":"15","a":"2026","e":"Altera os art. 150 Constituição Federal para incluir as entidades esportivas sem fins lucrativos.","d":"2026-06-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2604173","tp":"PEC","n":"3","a":"2026","e":"Altera o art. 155 da Constituição Federal para estabelecer alíquota máxima e base de cálculo exclusiva do Imposto sobre a Propriedade de Veículos Automotores – IPVA, e acrescenta dispositivos ao Ato das Disposições Constitucionais Transitórias para limitar despesas com publicidade institucional e com o Poder Legislativo.","d":"2026-02-24","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2603106","tp":"PL","n":"567","a":"2026","e":"Altera a Lei n° 8.080, de 19 de setembro de 1990, para incluir a disponibilização, pelos gestores públicos, de ferramenta destinada aos usuários do Sistema Único de Saúde (SUS) que possibilite o acesso, em tempo real, a informações sobre regulação assistencial.","d":"2026-02-13","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2598476","tp":"PL","n":"6536","a":"2025","e":"Altera a Lei n° 8.080, de 19 de setembro de 1990, para prever a disponibilização, pelos gestores públicos, de ferramenta destinada aos usuários do Sistema Único de Saúde (SUS) para acesso, em tempo real, a informações sobre regulação assistencial.","d":"2025-12-18","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2598301","tp":"PEC","n":"50","a":"2025","e":"Altera os artigos 103-B e 130-A da Constituição Federal, para modificar a composição do Conselho Nacional de Justiça e do Conselho Nacional do Ministério Público.","d":"2025-12-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2596372","tp":"PEC","n":"49","a":"2025","e":"Altera o § 4º do art. 220 da Constituição Federal para dispor sobre restrições legais à propaganda de qualquer modalidade lotérica.","d":"2025-12-12","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2595818","tp":"PEC","n":"48","a":"2025","e":"Altera o inciso XVI do art. 37 da Constituição Federal para permitir a acumulação de cargos públicos por outros profissionais da área da educação.","d":"2025-12-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2594082","tp":"PL","n":"6242","a":"2025","e":"Institui o Sistema Nacional de Alerta de Emergência para o resgate de pessoas idosas e pessoas com deficiência desaparecidas, denominado \"Alerta Prata Nacional\", e dá outras providências.","d":"2025-12-09","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2592244","tp":"PL","n":"6165","a":"2025","e":"Altera a Lei nº 13.146, de 6 de julho de 2015, Lei Brasileira de Inclusão, e a Lei n° 9.394, de 20 de dezembro de 1996, Lei de Diretrizes e Bases da Educação Nacional, para assegurar aos estudantes com deficiência, doenças crônicas, alergia ou intolerância alimentar o ingresso em instituições de ensino básico, portanto alimento próprio.","d":"2025-12-03","s":"Aguardando Parecer","autor_principal":true},{"id":"2591196","tp":"PEC","n":"46","a":"2025","e":"Altera a redação do § 4º do art. 212 da Constituição Federal para considerar o programa de alimentação escolar como despesa de manutenção e desenvolvimento de ensino.","d":"2025-12-02","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2587731","tp":"PL","n":"5967","a":"2025","e":"Altera a Lei nº 13.146, de 6 de julho de 2015, Lei Brasileira de Inclusão, e a Lei nº 12.764, de 27 de dezembro de 2012, Política Nacional de Proteção dos Direitos das Pessoas com Transtorno do Espectro Autista, para determinar a adaptação dos sinais sonoros por sons adequados em instituições de ensino.","d":"2025-11-25","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2585480","tp":"PL","n":"5884","a":"2025","e":"Altera a Lei nº 13.019, de 2014, que estabelece o regime jurídico das parcerias voluntárias, envolvendo ou não a transferência de recursos financeiros, entre a Administração Pública e as organizações da sociedade civil, para ampliar o rol de vedações à celebração de parcerias.","d":"2025-11-18","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2578996","tp":"PEC","n":"40","a":"2025","e":"Altera o Art. 7° da Constituição Federal para prever a possibilidade de opção pelos empregados quanto à jornada de trabalho, podendo escolher entre o regime comum previsto pela Consolidação das Leis do Trabalho (CLT), ou um regime flexível baseado em horas trabalhadas.","d":"2025-10-29","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2576168","tp":"PEC","n":"38","a":"2025","e":"Altera normas sobre a Administração Pública brasileira para aperfeiçoar a governança e a gestão pública, promover a transformação digital, impulsionar a profissionalização e extinguir privilégios no serviço público.","d":"2025-10-24","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2551011","tp":"PEC","n":"32","a":"2025","e":"Esta Lei altera o artigo 5º, inciso XLIII, da Constituição Federal, o qual prevê que nos casos de crimes previstos neste inciso, a pena deverá ser cumprida integralmente em regime fechado, por eles respondendo os mandantes, os executores e os que, podendo evitá-los, se omitirem, e dá outras providências.","d":"2025-08-20","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2544926","tp":"PEC","n":"31","a":"2025","e":"Altera os arts. 5º e 10 da Emenda Constitucional nº 103, de 12 de novembro de 2019, para reduzir a idade de aposentadoria da mulher ocupante de cargo de agente penitenciário, agente socioeducativo ou de policial dos órgãos referidos.","d":"2025-08-13","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2543145","tp":"PEC","n":"30","a":"2025","e":"Altera a Constituição Federal e o Ato das Disposições Constitucionais Transitórias para estabelecer regras antiprivilégios para agentes públicos.","d":"2025-08-12","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2517986","tp":"PL","n":"2615","a":"2025","e":"Altera a Lei n° 6.360, de 23 de setembro de 1976, que dispõe sobre a Vigilância Sanitária a que ficam sujeitos os Medicamentos, as Drogas, os Insumos Farmacêuticos e Correlatos, Cosméticos, Saneantes e Outros Produtos, e dá outras providências, para proibir a utilização de corantes alimentícios derivados de petróleo.","d":"2025-05-28","s":"Aguardando Parecer","autor_principal":true},{"id":"2499794","tp":"PEC","n":"17","a":"2025","e":"Acrescenta os §§ 11, 12 e 13 ao art. 144 da Constituição Federal, para instituir o piso salarial dos servidores policiais civis e militares e bombeiros militares.","d":"2025-04-23","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2487818","tp":"PEC","n":"12","a":"2025","e":"Altera o art. 50 da Constituição da República, para incluir o Presidente do Banco Central no rol das autoridades, que a Câmara dos Deputados e o Senado Federal, ou quaisquer de suas Comissões, podem convocar para prestar informações sobre assunto previamente determinado.","d":"2025-03-19","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2487249","tp":"PEC","n":"10","a":"2025","e":"Altera o Artigo 133º da Constituição Federal, que dispõe sobre a importância do exercicio do advogado, junto a administração da justiça.","d":"2025-03-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2485341","tp":"PEC","n":"8","a":"2025","e":"Dá nova redação ao inciso XIII, do artigo 7° da Constituição Federal para dispor sobre a redução da jornada de trabalho para quatro dias por semana no Brasil.","d":"2025-02-25","s":"Arquivada","autor_principal":false},{"id":"2482078","tp":"PDL","n":"3","a":"2025","e":"Susta os efeitos da Resolução nº 258, de 23 de dezembro de 2024, do Conselho Nacional dos Direitos da Criança e do Adolescente (CONANDA).","d":"2025-02-02","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2471383","tp":"PEC","n":"44","a":"2024","e":"Altera o §9º do artigo 166 da Constituição Federal para destinar parte dos recursos oriundos das emendas individuais a programas e ações relacionados ao Esporte.","d":"2024-11-26","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2458742","tp":"PEC","n":"34","a":"2024","e":"Inclui a primeira infância como beneficiária de direitos e garantias, no Texto Constitucional.","d":"2024-09-19","s":"Apresentação de Requerimento","autor_principal":false},{"id":"2455515","tp":"PEC","n":"31","a":"2024","e":"Acrescenta os arts.91-A, 91-B e a alínea “g” do inciso I do artigo 159 da Constituição Federal, para instituir o Conselho Nacional de Mudança Climática, a Autoridade Climática Nacional e o Fundo Nacional de Mudança Climática.","d":"2024-08-27","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2448752","tp":"PEC","n":"29","a":"2024","e":"Altera a Constituição Federal para acrescentar no art. 5º texto sobre o marco temporal de início da vida humana explicitando de forma inequívoca a inviolabilidade do direito à vida, desde a sua concepção, bem como cria o inciso LXXX para especificar que a concepção é a junção do gameta masculino e o feminino, ocorrida durante a fecundação, em local propício para o desenvolvimento celular.","d":"2024-07-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2448732","tp":"PEC","n":"28","a":"2024","e":"Acrescenta o art. 97-A e §§4º e 5º da Constituição Federal de 1988, para estabelecer o julgamento de referendo de liminares pelo colegiado de Tribunal, bem como criar hipótese de sustação de decisão do Supremo Tribunal Federal.","d":"2024-07-10","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2442880","tp":"PEC","n":"24","a":"2024","e":"Altera os §§ 4º, 4°-B e 7º do art. 40 da Constituição Federal e os artigos 5º, 10, 23, 24 e 26 da Emenda Constitucional nº 103, de 2019, acrescenta o art. 144-A a Constituição e dá outras providências.","d":"2024-06-24","s":"Aguardando Constituição de Comissão Temporária","autor_principal":false},{"id":"2405983","tp":"PEC","n":"63","a":"2023","e":"Dá nova redação ao art. 195 da Constituição Federal, para substituir as contribuições sobre a folha de salários e sobre a receita ou faturamento pela contribuição sobre a movimentação ou transmissão de valores e de créditos e direitos de natureza financeira, e dá outras providências.","d":"2023-11-22","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2402861","tp":"PEC","n":"57","a":"2023","e":"Altera os arts. 40 e 144 da Constituição Federal para dispor sobre as Polícias Municipais.","d":"2023-11-08","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2377463","tp":"PEC","n":"34","a":"2023","e":"Inclui dispositivos nos artigos 3º e 5º da Constituição da República Federativa do Brasil, estabelecendo o combate às drogas ilícitas como princípio fundamental e vedando expressamente a descriminalização do tráfico e a legalização de novas drogas recreativas.","d":"2023-08-09","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2363434","tp":"PEC","n":"27","a":"2023","e":"Altera o art. 159 da Constituição Federal para disciplinar a distribuição de recursos pela União ao Fundo de Participação dos Municípios, criar os Fundos Constitucionais de financiamento das Regiões Sul e Sudeste, e dá outras providências.","d":"2023-05-18","s":"Designação de Relator(a)","autor_principal":false},{"id":"2362526","tp":"PEC","n":"25","a":"2023","e":"Acrescenta o Capítulo IX ao Título VIII para oferecer diretrizes sobre o direito social ao transporte previsto no art. 6º e sobre o Sistema único de Mobilidade e autoriza a União, Distrito Federal e Municípios a instituírem\ncontribuição pelo uso do sistema viário, destinada ao custeio do transporte público coletivo urbano.","d":"2023-05-16","s":"Pronta para Pauta","autor_principal":false},{"id":"2362521","tp":"PL","n":"2599","a":"2023","e":"Altera a Lei nº 9.394/9 que estabelece as Diretrizes e Bases da Educação Nacional para incluir especialização adequada específica dos professores visando o atendimento aos educandos autistas, nos sistemas de ensino \nregular.","d":"2023-05-16","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2352476","tp":"PEC","n":"9","a":"2023","e":"Altera a Emenda Constitucional nº 117, de 5 de abril de 2022, quanto à aplicação de sanções aos partidos que não preencheram a cota mínima de recursos ou que não destinaram os valores mínimos em razão de sexo e raça em eleições, bem como nas prestações de contas anuais e eleitorais.\r\n\r\nNOVA EMENTA: Impõe aos partidos políticos a obrigatoriedade da aplicação de recursos financeiros para as candidat","d":"2023-03-22","s":"Transformado em Norma Jurídica","autor_principal":false},{"id":"2351680","tp":"PEC","n":"7","a":"2023","e":"Altera o art. 84, XII, da Constituição Federal de 1988, para estabelecer parâmetro para a concessão de indulto e comutação de penas pelo Presidente da República.","d":"2023-03-16","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2351506","tp":"PEC","n":"5","a":"2023","e":"Acrescenta § 4º-A ao art. 150 da Constituição Federal, para dispor sobre a imunidade tributária de que tratam as suas alíneas “b” e “c” do inciso VI.","d":"2023-03-15","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2345680","tp":"PDL","n":"3","a":"2023","e":"Susta o Decreto nº 11.366, de 1º de janeiro 2023, que limita o registro e a aquisição de armas de fogos.","d":"2023-02-02","s":"Aguardando Parecer","autor_principal":false}]},"votos":{"lista":[[0,"S","S","PSD",""],[1,"S","S","PSD",""],[2,"N","S","PSD",""],[4,"S","N","PSD","N"],[6,"N","N","PSD","L"],[7,"S","S","PSD","S"],[8,"S","S","PSD","S"],[9,"S","S","PSD","S"],[10,"N","S","PSD","S"],[11,"S","S","PSD","S"],[12,"N","S","PSD","S"],[13,"S","S","PSD","S"],[14,"S","S","PSD","S"],[15,"S","S","PSD","S"],[17,"N","N","PSD","N"],[18,"N","N","PSD","N"],[19,"N","N","PSD","L"],[21,"N","S","PSD","S"],[22,"S","S","PSD","S"],[23,"S","S","PSD","S"],[24,"S","S","PSD","S"],[25,"N","N","PSD","N"],[26,"S","S","PSD","S"],[28,"S","S","PSD","S"],[29,"S","S","PSD","L"],[30,"S","S","PSD","S"],[34,"S","S","PSD","L"],[35,"S","S","PSD","S"],[36,"N","N","PSD","N"],[37,"S","S","PSD","S"],[38,"S","S","PSD","S"],[39,"N","N","PSD","N"],[40,"S","S","PSD","S"],[41,"N","N","PSD","N"],[42,"S","S","PSD","S"],[43,"A","S","PSD","L"],[44,"S","S","PSD","S"],[47,"N","N","PSD","N"],[48,"N","N","PSD","N"],[49,"S","S","PSD","S"],[50,"A