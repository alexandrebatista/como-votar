{"id":204459,"nome":"Daniela do Waguinho","partido":"REPUBLICANOS","uf":"RJ","foto":"https://www.camara.leg.br/internet/deputado/bandep/204459.jpg","inicio":"2023-02-02","fim":"2026-09-03","meses":40,"em_exercicio":true,"ideologia":{"nota":7.78,"faixa":"direita","campo":"direita","estimado":false,"obs":"nota do PRB, nome anterior"},"ideologia_voto":{"nota":2.19,"faixa":"esquerda","campo":"esquerda","n":161},"candidatura":{"cargo":"Deputado Federal","uf":"RJ","partido":"REPUBLICANOS","numero":"1045","nome_urna":"Daniela Do Waguinho","reeleicao":true,"cruzamento":"exato","outros_registros":[],"substituidos":[]},"candidatura_substituida":null,"partido_voto":{"nota":5.67,"faixa":"centro-direita","n":47,"q1":5.31,"q3":6.46},"propostas":{"contagem":{"REQ":111,"PL":29,"EMP":24,"RPD":20,"PRL":16,"PEC":13,"EMC":12,"SBT":11,"INC":8,"RCP":4,"PLP":3,"SLD":3,"EMR":2,"SOR":2,"REC":2,"PRLP":2,"DOC":1,"PRC":1,"CVO":1,"RDF":1,"PPP":1},"lista":[{"id":"2635883","tp":"PL","n":"3377","a":"2026","e":"Altera a Lei nº 14.133, de 1º de abril de 2021, para dispor sobre contratação pública de bens e serviços artesanais.","d":"2026-06-30","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2633488","tp":"PEC","n":"15","a":"2026","e":"Altera os art. 150 Constituição Federal para incluir as entidades esportivas sem fins lucrativos.","d":"2026-06-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2632528","tp":"PL","n":"3120","a":"2026","e":"Institui regras de advertência sanitária e transparência na publicidade, promoção e divulgação de esteroides anabolizantes, substâncias hormonais e produtos correlatos com potencial risco à saúde, inclusive em ambientes digitais, e altera a Lei nº 6.437, de 20 de agosto de 1977, a Lei nº 9.294, de 15 de julho de 1996, e a Lei nº 9.965, de 27 de abril de 2000.","d":"2026-06-15","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2630076","tp":"PL","n":"2881","a":"2026","e":"Altera a Lei nº 10.741, de 1º de outubro de 2003 (Estatuto da Pessoa Idosa), para estabelecer medidas de segurança e assistência à pessoa idosa no embarque e desembarque em transporte aéreo.","d":"2026-06-03","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2625893","tp":"PL","n":"2478","a":"2026","e":"Altera a Lei nº 14.790, de 29 de dezembro de 2023, para dispor sobre a proteção da saúde mental, do consumidor e da economia familiar no ambiente de apostas de quota fixa e jogos online, com ênfase na prevenção e redução de danos, e dá outras providências.","d":"2026-05-19","s":"Apresentação de Requerimento","autor_principal":false},{"id":"2624705","tp":"PL","n":"2390","a":"2026","e":"Institui a Política Nacional de Endereçamento Postal, reconhece o endereçamento como instrumento de cidadania e dá outras providências.","d":"2026-05-13","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2619180","tp":"PL","n":"2049","a":"2026","e":"Altera a Lei nº 12.764, de 27 de dezembro de 2012, para dispor sobre diretrizes voltadas ao atendimento e à inclusão da pessoa com Transtorno do Espectro Autista na vida adulta.","d":"2026-04-28","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2606313","tp":"PLP","n":"41","a":"2026","e":"Dispõe sobre o Sistema Nacional de Enfrentamento da Violência contra Meninas e Mulheres e a destinação de recursos às ações de enfrentamento ao feminicídio e de garantia da vida de meninas e mulheres.","d":"2026-03-03","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2605145","tp":"PL","n":"805","a":"2026","e":"Dispõe sobre o enfrentamento à violência digital contra as mulheres por sua condição de mulher, com base na Lei Modelo Interamericana para Prevenir, Punir e Erradicar a Violência Digital de Gênero contra as Mulheres, elaborada no âmbito da Organização dos Estados Americanos (OEA).","d":"2026-02-26","s":"Aguardando Parecer","autor_principal":false},{"id":"2605144","tp":"PL","n":"804","a":"2026","e":"Institui normas gerais de segurança sanitária, prevenção de acidentes químicos e controle da qualidade da água em piscinas e ambientes aquáticos de uso coletivo, e dá outras providências.","d":"2026-02-26","s":"Aguardando Parecer","autor_principal":true},{"id":"2604173","tp":"PEC","n":"3","a":"2026","e":"Altera o art. 155 da Constituição Federal para estabelecer alíquota máxima e base de cálculo exclusiva do Imposto sobre a Propriedade de Veículos Automotores – IPVA, e acrescenta dispositivos ao Ato das Disposições Constitucionais Transitórias para limitar despesas com publicidade institucional e com o Poder Legislativo.","d":"2026-02-24","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2600760","tp":"PL","n":"260","a":"2026","e":"Institui o Protocolo Nacional de Atendimento Humanizado às Mulheres em Situação de Violência a ser adotado, em todo o território nacional, pelas Delegacias Especializadas de Atendimento à Mulher (DEAMs) e demais unidades policiais que dispensam atendimento às mulheres em situação de violência.","d":"2026-02-04","s":"Aguardando Parecer","autor_principal":false},{"id":"2597573","tp":"PL","n":"6482","a":"2025","e":"Amplia a proteção às vítimas de crimes sexuais, institui protocolos de acolhimento, estabelece medidas protetivas digitais, assegura acesso integral aos autos processuais, possibilita protocolo direto de provas pelas vítimas e veda o uso de imagens manipuladas nos processos judiciais.","d":"2025-12-16","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2596372","tp":"PEC","n":"49","a":"2025","e":"Altera o § 4º do art. 220 da Constituição Federal para dispor sobre restrições legais à propaganda de qualquer modalidade lotérica.","d":"2025-12-12","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2595818","tp":"PEC","n":"48","a":"2025","e":"Altera o inciso XVI do art. 37 da Constituição Federal para permitir a acumulação de cargos públicos por outros profissionais da área da educação.","d":"2025-12-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":true},{"id":"2594441","tp":"PL","n":"6259","a":"2025","e":"Altera a Lei nº 14.965, de 9 de setembro de 2024 (Lei Geral dos Concursos Públicos), para dispor sobre o direito à nomeação de candidatos aprovados em concursos públicos, e dá outras providências.","d":"2025-12-09","s":"Pronta para Pauta","autor_principal":true},{"id":"2593723","tp":"PL","n":"6222","a":"2025","e":"Institui a Mobilização Nacional dos 21 Dias de Ativismo pelo Fim da Violência contra as Mulheres, realizado anualmente, entre 20 de novembro e 10 de dezembro, destinado a intensificar ações de prevenção, enfrentamento e superação das violências contra as mulheres, por meio de articulação nacional entre o poder público, os entes federativos, a sociedade civil e a iniciativa privada.","d":"2025-12-08","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2574270","tp":"PL","n":"5339","a":"2025","e":"Altera o art. 1691 da Lei n° 10.406, de 2002, Código Civil, para vedar a tomada de crédito ou a prestação de garantia, pelos pais, em nome dos filhos.","d":"2025-10-21","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2570034","tp":"PL","n":"5043","a":"2025","e":"Altera a Lei nº 8.069, de 13 de julho de 1990 (Estatuto da Criança e do Adolescente), para instituir a obrigatoriedade da formação inicial e continuada de Conselheiros Tutelares e dispor sobre a Política Nacional de Formação.","d":"2025-10-08","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2552615","tp":"PL","n":"4228","a":"2025","e":"Altera as Leis nº 9.096, de 19 de setembro de 1995, e nº 9.504, de 30 de setembro de 1997, para instituir cotas para a juventude no Fundo Partidário e no Fundo Especial de Financiamento de Campanha, e tornar obrigatória a criação de órgão de juventude nos partidos políticos.","d":"2025-08-26","s":"Publicação de Proposição","autor_principal":true},{"id":"2551928","tp":"PL","n":"4196","a":"2025","e":"Dispõe sobre a proteção, prevenção e combate aos maus-tratos de animais; estabelece protocolos obrigatórios de bem-estar em atividades públicas e privadas que envolvam animais; define a responsabilização solidária de organizadores, proprietários e responsáveis; e dá outras providências.","d":"2025-08-25","s":"Aguardando Parecer","autor_principal":true},{"id":"2542404","tp":"PL","n":"3894","a":"2025","e":"Institui o Botão de Alerta Infantil nas plataformas digitais, para denúncia e retirada preventiva de conteúdos com indícios de exposição abusiva ou sexualização de crianças e adolescentes, e dá outras providências.","d":"2025-08-11","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Análise)","autor_principal":true},{"id":"2527379","tp":"PL","n":"3012","a":"2025","e":"Estabelece normas gerais de segurança, operação e responsabilidade para o balonismo tripulado livre recreativo no Brasil, com exigências de certificação, seguro, habilitação, informação ao consumidor, requisitos para equipamentos e protocolo de revisão regulatória em caso de acidentes com vítimas.","d":"2025-06-23","s":"Notificações","autor_principal":true},{"id":"2515957","tp":"PL","n":"2521","a":"2025","e":"Dispõe sobre diretrizes para a implantação de unidades de diagnóstico e tratamento de zoonoses no âmbito do Sistema Único de Saúde (SUS) e dá outras providências.","d":"2025-05-23","s":"Aguardando Parecer","autor_principal":true},{"id":"2487249","tp":"PEC","n":"10","a":"2025","e":"Altera o Artigo 133º da Constituição Federal, que dispõe sobre a importância do exercicio do advogado, junto a administração da justiça.","d":"2025-03-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2485767","tp":"PEC","n":"9","a":"2025","e":"Acrescenta o § 16 ao art. 198 da Constituição Federal, para dispor sobre as diretrizes para os Planos de Carreira e os pisos salariais nacionais dos profissionais de saúde do Sistema Único de Saúde.","d":"2025-02-27","s":"Aguardando Parecer","autor_principal":false},{"id":"2485341","tp":"PEC","n":"8","a":"2025","e":"Dá nova redação ao inciso XIII, do artigo 7° da Constituição Federal para dispor sobre a redução da jornada de trabalho para quatro dias por semana no Brasil.","d":"2025-02-25","s":"Arquivada","autor_principal":false},{"id":"2483701","tp":"PL","n":"395","a":"2025","e":"Altera o art. 6º da Lei nº 8.078, de 11 de setembro de 1990, a fim de incluir no rol de direitos básicos do consumidor a comunicação direta com o fornecedor por meio dos canais de atendimento disponibilizados, inclusive telefônico, sem custos para o consumidor, para fins de informação, reclamação, contestação, suspensão, cancelamento ou devolução de produtos e serviços.","d":"2025-02-11","s":"Pronta para Pauta","autor_principal":true},{"id":"2483164","tp":"PEC","n":"2","a":"2025","e":"Dá nova redação ao Capítulo II, do Título IV, da Constituição Federal, que dispõe sobre o Poder Executivo e dá outras providências.","d":"2025-02-06","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2483076","tp":"PRC","n":"7","a":"2025","e":"Altera o Regimento Interno da Câmara dos Deputados para dispor sobre o prazo para tramitação de requerimento de urgência e de proposições em regime de urgência.","d":"2025-02-05","s":"Pronta para Pauta","autor_principal":false},{"id":"2478427","tp":"PEC","n":"48","a":"2024","e":"Altera o art. 53 da Constituição Federal para deixar explícito que a imunidade material de Deputados e Senadores se aplica independentemente do local em que forem proferidas opiniões, palavras e votos, e para determinar ao Ministro do Supremo Tribunal Federal que, no exercício de suas funções, contrariar esta disposição, a pena de perda do cargo, sem vencimentos e com inabilitação, por até cinco a","d":"2024-12-11","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2477895","tp":"PL","n":"4806","a":"2024","e":"Dispõe sobre o incentivo à criação e o fortalecimento das capacidades institucionais de órgãos de defesa e promoção de direitos e enfrentamento à violência contra a mulher nas Unidades da Federação.","d":"2024-12-10","s":"Aguardando Parecer","autor_principal":true},{"id":"2471383","tp":"PEC","n":"44","a":"2024","e":"Altera o §9º do artigo 166 da Constituição Federal para destinar parte dos recursos oriundos das emendas individuais a programas e ações relacionados ao Esporte.","d":"2024-11-26","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2467670","tp":"PEC","n":"42","a":"2024","e":"Acrescenta o inciso VI ao art. 51 da Constituição Federal, para estabelecer competência privativa à Câmara dos Deputados relativa à fiscalização das atividades das agências reguladoras.","d":"2024-11-11","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2462001","tp":"PL","n":"3877","a":"2024","e":"Altera a Lei nº 9.294, de 15 de julho de 1996, para restringir a propaganda de jogos de azar, apostas de quota fixa e de atividades de natureza sexual, e a Lei nº 14.790, de 29 de dezembro de 2023, para restringir a propaganda de apostas de quota fixa.","d":"2024-10-09","s":"Aguardando Parecer","autor_principal":true},{"id":"2455515","tp":"PEC","n":"31","a":"2024","e":"Acrescenta os arts.91-A, 91-B e a alínea “g” do inciso I do artigo 159 da Constituição Federal, para instituir o Conselho Nacional de Mudança Climática, a Autoridade Climática Nacional e o Fundo Nacional de Mudança Climática.","d":"2024-08-27","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2454257","tp":"PLP","n":"136","a":"2024","e":"Altera a Lei Complementar nº79, de 7 de janeiro de 1994, e a Leinº 13.756, de 12 de dezembro de 2018, para dispor, expressamente, sobre a aplicação de recursos do Fundo Penitenciário Nacional (FUPEN) e do Fundo Nacional de Segurança Pública (FNSP) em órgãos e entidadesque implementam ações de prevenção e enfrentamento da violência contra a mulher nos âmbitos estadual e municipal.","d":"2024-08-21","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2448752","tp":"PEC","n":"29","a":"2024","e":"Altera a Constituição Federal para acrescentar no art. 5º texto sobre o marco temporal de início da vida humana explicitando de forma inequívoca a inviolabilidade do direito à vida, desde a sua concepção, bem como cria o inciso LXXX para especificar que a concepção é a junção do gameta masculino e o feminino, ocorrida durante a fecundação, em local propício para o desenvolvimento celular.","d":"2024-07-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2439906","tp":"PL","n":"2318","a":"2024","e":"Altera a Lei nº 11.692, de 10 de junho de 2008, que dispõe sobre o Programa Nacional de Inclusão de Jovens - Projovem, para estender o Projovem Adolescente - Serviço Socioeducativo ao jovem egresso de acolhimento institucional ou familiar; a Lei nº 14.601, de 19 de junho de 2023, que institui o Programa Bolsa Família, para prever prioridade de reingresso e pagamento de Benefício Variável Familiar ","d":"2024-06-11","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2439904","tp":"PL","n":"2316","a":"2024","e":"Altera o Decreto-Lei nº 986, de 21 de outubro de 1969, para dispor sobre o tamanho das letras utilizadas nos rótulos e embalagens de alimentos.","d":"2024-06-11","s":"Aguardando Parecer","autor_principal":true},{"id":"2435251","tp":"PL","n":"1970","a":"2024","e":"Altera a Lei nº 9.656, de 3 de junho de 1998, que dispõe sobre planos privados de assistência à saúde, para tratar da garantia de continuidade da assistência a beneficiários.","d":"2024-05-21","s":"Notificacao para Publica