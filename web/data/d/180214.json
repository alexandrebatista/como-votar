{"id":180214,"nome":"Pastor Diniz","partido":"UNIÃO","uf":"RR","foto":"https://www.camara.leg.br/internet/deputado/bandep/180214.jpg","inicio":"2023-02-02","fim":"2026-09-03","meses":40,"em_exercicio":true,"ideologia":{"nota":8.34,"faixa":"direita","campo":"direita","estimado":true,"obs":"partido criado em 2022; média das notas de PSL (8,11) e DEM (8,57), que se fundiram"},"ideologia_voto":{"nota":9.41,"faixa":"extrema-direita","campo":"direita","n":161},"candidatura":{"cargo":"Deputado Federal","uf":"RR","partido":"UNIÃO","numero":"4422","nome_urna":"Pastor Diniz","reeleicao":true,"cruzamento":"exato","outros_registros":[],"substituidos":[]},"candidatura_substituida":null,"partido_voto":{"nota":5.93,"faixa":"centro-direita","n":57,"q1":5.41,"q3":6.69},"propostas":{"contagem":{"REQ":320,"PRL":112,"PEC":28,"EMC":28,"SBT":24,"RPD":19,"EMP":18,"PL":15,"RCP":14,"PDL":10,"REC":7,"EMR":6,"SOR":6,"RIC":5,"ESB":3,"INC":1,"DOC":1},"lista":[{"id":"2644800","tp":"PEC","n":"16","a":"2026","e":"Acrescenta os art. 68-A no Ato das Disposições Constitucionais Transitórias para ratificar os registros de imóveis rurais em faixa de fronteira concedidos pelos estados antes da promulgação desta Constituição Federal e dá outras providências.","d":"2026-08-28","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2623604","tp":"PEC","n":"9","a":"2026","e":"Altera o art. 228 da Constituição Federal, para reduzir a idade mínima de imputabilidade penal, nas condições que estabelece.","d":"2026-05-12","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2623400","tp":"PEC","n":"8","a":"2026","e":"Altera o art. 228 da Constituição Federal para admitir, em caráter excepcional, a redução da maioridade penal em casos de crimes hediondos e de crueldade extrema contra pessoas e animais.","d":"2026-05-11","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2617450","tp":"PDL","n":"255","a":"2026","e":"Susta a eficácia do inciso XL do Art. 9°-C do Anexo XXI da Portaria de Consolidação GM/MS n° 2, de 28 de setembro de 2017, incluído pela Portaria GM/MS n° 10.719, de 7 de abril de 2026, que dispõe sobre a composição do Comitê Técnico Nacional de Saúde LGBTIA+.","d":"2026-04-22","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2613286","tp":"PL","n":"1581","a":"2026","e":"Altera a Lei nº 12.111, de 9 de dezembro de 2009, para reverter, de 2026 a 2030, parcela da redução dos dispêndios da CCC decorrente da conexão de concessionária de distribuição de energia elétrica ao Sistema Interligado Nacional em 2025 à modicidade tarifária na respectiva área de concessão.","d":"2026-04-01","s":"Aguardando Parecer","autor_principal":true},{"id":"2604173","tp":"PEC","n":"3","a":"2026","e":"Altera o art. 155 da Constituição Federal para estabelecer alíquota máxima e base de cálculo exclusiva do Imposto sobre a Propriedade de Veículos Automotores – IPVA, e acrescenta dispositivos ao Ato das Disposições Constitucionais Transitórias para limitar despesas com publicidade institucional e com o Poder Legislativo.","d":"2026-02-24","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2590005","tp":"PL","n":"6062","a":"2025","e":"Dispõe sobre medidas de combate à exploração ilegal de apostas e jogos on-line, reforçando os mecanismos de integridade esportiva e de repressão a transações financeiras ilícitas.","d":"2025-12-02","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2586691","tp":"PL","n":"5922","a":"2025","e":"Dispõe sobre o Consentimento Livre e Esclarecido nas relações de prestação de serviços de saúde no âmbito público e privado.","d":"2025-11-19","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2578996","tp":"PEC","n":"40","a":"2025","e":"Altera o Art. 7° da Constituição Federal para prever a possibilidade de opção pelos empregados quanto à jornada de trabalho, podendo escolher entre o regime comum previsto pela Consolidação das Leis do Trabalho (CLT), ou um regime flexível baseado em horas trabalhadas.","d":"2025-10-29","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2576168","tp":"PEC","n":"38","a":"2025","e":"Altera normas sobre a Administração Pública brasileira para aperfeiçoar a governança e a gestão pública, promover a transformação digital, impulsionar a profissionalização e extinguir privilégios no serviço público.","d":"2025-10-24","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2575774","tp":"PL","n":"5401","a":"2025","e":"Dispõe sobre a cobrança de tributos incidentes sobre a exploração econômica de apostas de quota fixa no território nacional no período prévio à regulamentação da atividade, e dá outras providências.","d":"2025-10-23","s":"Aguardando Recurso","autor_principal":true},{"id":"2567615","tp":"PL","n":"4972","a":"2025","e":"Dispõe sobre a interpretação da legislação vigente sobre liberdade religiosa e sobre as relações entre religião e Estado nos marcos da laicidade colaborativa prevista no art. 19, I, da Constituição Federal.","d":"2025-10-06","s":"Aguardando Parecer","autor_principal":true},{"id":"2567043","tp":"PL","n":"4934","a":"2025","e":"Altera a Lei nº 12.965, de 23 de abril de 2014 (Marco Civil da Internet), e o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), para vedar a erotização precoce de crianças e adolescentes em provedores de aplicações de internet e estabelecer medidas de proteção no ambiente online.","d":"2025-10-02","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Análise)","autor_principal":true},{"id":"2566887","tp":"PL","n":"4931","a":"2025","e":"Dispõe sobre a contratação e permanência de trabalhadores com idade igual ou superior a 60 (sessenta) anos no mercado de trabalho formal, instituindo incentivos fiscais à contratação e o \"Selo Empresa Amiga do Idoso\", com o objetivo de promover a dignidade e inclusão social da pessoa idosa.","d":"2025-10-02","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2566886","tp":"PL","n":"4930","a":"2025","e":"Altera a Lei nº 12.651, de 25 de maio de 2012, para autorizar que imóveis rurais situados em floresta ou cerrado da Amazônia Legal utilizem a integralidade da Reserva Legal para fins de emissão de Cota de Reserva Ambiental (CRA).","d":"2025-10-02","s":"Pronta para Pauta","autor_principal":true},{"id":"2566885","tp":"PL","n":"4929","a":"2025","e":"Institui a Política Nacional de Economia de Impacto.","d":"2025-10-02","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2563273","tp":"PEC","n":"35","a":"2025","e":"Altera a Constituição Federal para acrescentar os §§ 4º e 5º ao art. 164 para determinar que a criação, emissão e circulação de qualquer moeda digital do Banco Central (CBDC) ou outro ativo digital requer aprovação das duas Casas do Congresso Nacional, bem como para determinar que a extinção do papel-moeda forçada no território nacional é vedada, salvo se aprovada em cada uma das duas Casas do Con","d":"2025-09-23","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2557024","tp":"PEC","n":"34","a":"2025","e":"Acrescenta o inciso IX ao art. 225, §º1 da Constituição Federal, a alínea “e” ao inciso II do art. 9º, §3º e o §14 ao art. 9º da Emenda Constitucional 132/2023 para corrigir o tratamento injusto concedido pela Reforma Tributária aos agentes que atuam no setor de reciclagem, desvalorizando os materiais recicláveis e desincentivando a economia circular.","d":"2025-09-03","s":"Aguardando Constituição de Comissão Temporária","autor_principal":false},{"id":"2543145","tp":"PEC","n":"30","a":"2025","e":"Altera a Constituição Federal e o Ato das Disposições Constitucionais Transitórias para estabelecer regras antiprivilégios para agentes públicos.","d":"2025-08-12","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2541107","tp":"PL","n":"3792","a":"2025","e":"Dispõe sobre a legitimidade dos partidos políticos nas ações do controle concentrado de constitucionalidade.","d":"2025-08-06","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Autorização)","autor_principal":false},{"id":"2538430","tp":"PL","n":"3622","a":"2025","e":"Extingue a cobrança do Imposto sobre Operações de Crédito, Câmbio e Seguro, ou relativas a Títulos ou Valores Mobiliários – IOF, por meio da revogação de sua disciplina infraconstitucional.","d":"2025-07-21","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2525262","tp":"PDL","n":"322","a":"2025","e":"Susta os efeitos do Decreto nº 12.499, de 11 de junho de 2025, que altera o Decreto nº 6.306, de 14 de dezembro de 2007, regulamentando o Imposto sobre Operações de Crédito, Câmbio e Seguro, ou relativas a Títulos ou Valores Mobiliários – IOF.","d":"2025-06-12","s":"Arquivada","autor_principal":false},{"id":"2516046","tp":"PDL","n":"228","a":"2025","e":"Susta, nos termos do art. 49, V, da Constituição Federal, os efeitos do Decreto nº 12.467, de 23 de maio de 2025.","d":"2025-05-26","s":"Aguardando Despacho do Presidente da Câmara dos Deputados","autor_principal":false},{"id":"2485341","tp":"PEC","n":"8","a":"2025","e":"Dá nova redação ao inciso XIII, do artigo 7° da Constituição Federal para dispor sobre a redução da jornada de trabalho para quatro dias por semana no Brasil.","d":"2025-02-25","s":"Arquivada","autor_principal":false},{"id":"2485216","tp":"PDL","n":"108","a":"2025","e":"Susta o parágrafo 6º do artigo 2º da Portaria do Ministério da Fazenda nº 1.138, de 10 de julho de 2024.","d":"2025-02-24","s":"Publicação de Proposição","autor_principal":false},{"id":"2482788","tp":"PDL","n":"61","a":"2025","e":"Susta o Decreto nº 12.373, de 31 de Janeiro de 2025, que Regulamenta o exercício do poder de polícia da Fundação Nacional dos Povos Indígenas, nos termos do art. 49, V da Constituição Federal.","d":"2025-02-04","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2482401","tp":"PDL","n":"41","a":"2025","e":"Susta os efeitos da Instrução Normativa RFB nº 2.219, de 17 de setembro de 2024, que estabelece a obrigatoriedade de reporte de movimentações financeiras de pessoas físicas e jurídicas à Receita Federal acima de determinados valores, incluindo transações via Pix.","d":"2025-02-03","s":"Arquivada","autor_principal":false},{"id":"2482262","tp":"PDL","n":"26","a":"2025","e":"Susta a Instrução Normativa da Receita Federal do Brasil n.º 2.219, de 17 de setembro de 2024, que “dispõe sobre a obrigatoriedade de prestação de informações relativas às operações financeiras de interesse da Secretaria Especial da Receita Federal do Brasil na e-Financeira.”","d":"2025-02-03","s":"Arquivada","autor_principal":false},{"id":"2471383","tp":"PEC","n":"44","a":"2024","e":"Altera o §9º do artigo 166 da Constituição Federal para destinar parte dos recursos oriundos das emendas individuais a programas e ações relacionados ao Esporte.","d":"2024-11-26","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2467670","tp":"PEC","n":"42","a":"2024","e":"Acrescenta o inciso VI ao art. 51 da Constituição Federal, para estabelecer competência privativa à Câmara dos Deputados relativa à fiscalização das atividades das agências reguladoras.","d":"2024-11-11","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2456494","tp":"PL","n":"3445","a":"2024","e":"Altera a Lei nº 7.998, de 11 de janeiro de 1990, para estabelecer destinação mínima de vagas de qualificação profissional para a Região Norte.","d":"2024-09-04","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2448752","tp":"PEC","n":"29","a":"2024","e":"Altera a Constituição Federal para acrescentar no art. 5º texto sobre o marco temporal de início da vida humana explicitando de forma inequívoca a inviolabilidade do direito à vida, desde a sua concepção, bem como cria o inciso LXXX para especificar que a concepção é a junção do gameta masculino e o feminino, ocorrida durante a fecundação, em local propício para o desenvolvimento celular.","d":"2024-07-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2448732","tp":"PEC","n":"28","a":"2024","e":"Acrescenta o art. 97-A e §§4º e 5º da Constituição Federal de 1988, para estabelecer o julgamento de referendo de liminares pelo colegiado de Tribunal, bem como criar hipótese de sustação de decisão do Supremo Tribunal Federal.","d":"2024-07-10","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2447265","tp":"PEC","n":"27","a":"2024","e":"Altera a Constituição Federal para acrescentar o Capítulo IX - Da Promoção Da Igualdade Racial, que institui o Fundo Nacional de Reparação Econômica e de Promoção da Igualdade Racial (FNREPIR) com o objetivo de promover a igualdade de oportunidades e a inclusão social dos brasileiros pretos e pardos, e dá outras providências","d":"2024-07-08","s":"Encerramentos","autor_principal":false},{"id":"2444647","tp":"PL","n":"2660","a":"2024","e":"Obriga o Sistema Único de Saúde a garantir a realização da reversão da cirurgia de mudança de sexo.","d":"2024-07-02","s":"Aguardando Parecer","autor_principal":false},{"id":"2442880","tp":"PEC","n":"24","a":"2024","e":"Altera os §§ 4º, 4°-B e 7º do art. 40 da Constituição Federal e os artigos 5º, 10, 23, 24 e 26 da Emenda Constitucional nº 103, de 2019, acrescenta o art. 144-A a Constituição e dá outras providências.","d":"2024-06-24","s":"Aguardando Constituição de Comissão Temporária","autor_principal":false},{"id":"2434493","tp":"PL","n":"1904","a":"2024","e":"Acresce dois parágrafos ao art. 124, um parágrafo único ao artigo 125, um segundo parágrafo ao artigo 126 e um parágrafo único ao artigo 128, todos do Código Penal Brasileiro, e dá outras providências.","d":"2024-05-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2432987","tp":"PEC","n":"17","a":"2024","e":"Acrescenta art. 132-A e altera o art. 168 da Constituição Federal, para conferir autonomia orçamentária às Procuradorias dos Estados e do Distrito Federal e à Advocacia-Geral da União e seus órgãos vinculados.","d":"2024-05-13","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2419066","tp":"PDL","n":"24","a":"2024","e":"Este Decreto Legislativo susta os efeitos da Nota Técnica Conjunta n° 2/2024-SAPS/SAES/MS.","d":"2024-02-29","s":"Devolvida ao(à) Autor(a)","autor_principal":false},{"id":"2406638","tp":"PEC","n":"64","a":"2023","e":"Altera  disposições  sobre  servidores policiais, para dispor sobre seu Regime Jurídico Policial.","d":"2023-11-24","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2405983","tp":"PEC","n":"63","a":"2023","e":"Dá nova redação ao art. 195 da Constituição Federal, para substituir as contribuições sobre a folha de salários e sobre a receita ou faturamento pela contribuição sobre a movimentação ou transmissão de valores e de créditos e direitos de natureza financeira, e dá outras providências.","d":"2023-11-22","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2404706","tp":"PEC","n":"62","a":"2023","e":"Altera o artigo 122 do Ato das Disposições Constitucionais Transitórias.","d":"2023-11-21","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2402861","tp":"PEC","n":"57","a":"2023","e":"Altera os arts. 40 e 144 da Constituição Federal para dispor sobre as Polícias Municipais.","d":"2023-11-08","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2395783","tp":"PL","n":"4978","a":"2023","e":"Altera a Lei n° 13.105, de 2015 (Código de Processo Civil) de modo a s