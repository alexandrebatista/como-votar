{"id":218086,"nome":"Ely Santos","partido":"REPUBLICANOS","uf":"SP","foto":"https://www.camara.leg.br/internet/deputado/bandep/218086.jpg","inicio":"2023-07-05","fim":"2026-03-26","meses":33,"em_exercicio":false,"ideologia":{"nota":7.78,"faixa":"direita","campo":"direita","estimado":false,"obs":"nota do PRB, nome anterior"},"ideologia_voto":{"nota":5.41,"faixa":"centro","campo":"centro","n":171},"candidatura":{"cargo":"Deputado Estadual","uf":"SP","partido":"REPUBLICANOS","numero":"10023","nome_urna":"Ely Santos","reeleicao":false,"cruzamento":"aproximado","outros_registros":[],"substituidos":[]},"candidatura_substituida":null,"partido_voto":{"nota":5.67,"faixa":"centro-direita","n":47,"q1":5.31,"q3":6.46},"propostas":{"contagem":{"PL":35,"REQ":33,"PEC":12,"RCP":7,"PRL":7,"INC":6,"EMC":4,"DOC":2,"SBT":2,"RPD":1,"PLP":1},"lista":[{"id":"2607448","tp":"PL","n":"1011","a":"2026","e":"Institui a Lei Trajeto Seguro, que estabelece mecanismos obrigatórios de segurança preventiva em aplicativos de transporte individual de passageiros e cria protocolos tecnológicos de proteção a usuárias, especialmente mulheres, durante corridas intermediadas por plataformas digitais.","d":"2026-03-06","s":"Pronta para Pauta","autor_principal":true},{"id":"2606313","tp":"PLP","n":"41","a":"2026","e":"Dispõe sobre o Sistema Nacional de Enfrentamento da Violência contra Meninas e Mulheres e a destinação de recursos às ações de enfrentamento ao feminicídio e de garantia da vida de meninas e mulheres.","d":"2026-03-03","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2604173","tp":"PEC","n":"3","a":"2026","e":"Altera o art. 155 da Constituição Federal para estabelecer alíquota máxima e base de cálculo exclusiva do Imposto sobre a Propriedade de Veículos Automotores – IPVA, e acrescenta dispositivos ao Ato das Disposições Constitucionais Transitórias para limitar despesas com publicidade institucional e com o Poder Legislativo.","d":"2026-02-24","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2604159","tp":"PL","n":"708","a":"2026","e":"Institui o Protocolo Nacional de Consulta Ginecológica Unificada e Prevenção Integral à Saúde da Mulher no âmbito do Sistema Único de Saúde – SUS, cria o Cadastro Nacional de Prevenção à Saúde da Mulher, estabelecendo deveres da União, dos Estados, do Distrito Federal e dos Municípios, e dá outras providências","d":"2026-02-24","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2602136","tp":"PL","n":"440","a":"2026","e":"Institui a obrigatoriedade de disponibilização da modalidade “Bandeira Rosa” nos serviços de transporte remunerado privado individual de passageiros por aplicativo, como política nacional de proteção à mulher, liberdade de escolha e inclusão produtiva feminina, e dá outras providências.","d":"2026-02-10","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2600593","tp":"PL","n":"206","a":"2026","e":"Altera o § 1º-A do art. 32 da Lei nº 9.605, de 12 de fevereiro de 1998 (Lei de Crimes Ambientais), para aumentar a pena cominada aos crimes de maus-tratos contra animais, e veda a substituição da pena privativa de liberdade por pena restritiva de direitos exclusivamente pecuniária nas hipóteses que especifica, denominando-se “Lei cão Orelha”.","d":"2026-02-03","s":"Aguardando Deliberação","autor_principal":true},{"id":"2598150","tp":"PL","n":"6491","a":"2025","e":"Cria a indenização automática, progressiva e proporcional aos Consumidores pela interrupção no fornecimento de energia elétrica e dá outras providências.","d":"2025-12-17","s":"Aguardando Parecer","autor_principal":true},{"id":"2576168","tp":"PEC","n":"38","a":"2025","e":"Altera normas sobre a Administração Pública brasileira para aperfeiçoar a governança e a gestão pública, promover a transformação digital, impulsionar a profissionalização e extinguir privilégios no serviço público.","d":"2025-10-24","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2570215","tp":"PL","n":"5055","a":"2025","e":"Dispõe sobre a obrigatoriedade de existência de acessos distintos para vítimas e agressores em todas as Delegacias de Polícia e Institutos Médicos Legais (IML) do território nacional, e dá outras providências.","d":"2025-10-08","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2566608","tp":"PL","n":"4916","a":"2025","e":"Dispõe sobre a correção de disparidade injustificada existente no Código Penal Brasileiro atinente à punição dos crimes mais graves contra a vida e a dignidade sexual, estabelecendo mínimo de 30 (trinta) e máximo de 40 (quarenta) anos de reclusão.","d":"2025-10-01","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2550941","tp":"PL","n":"4149","a":"2025","e":"Institui a Lei de Bem-Estar Equino, estabelecendo normas para a proteção, manejo responsável e promoção do bem-estar de cavalos e demais equídeos em todo o território nacional.","d":"2025-08-20","s":"Aguardando Parecer","autor_principal":true},{"id":"2549517","tp":"PL","n":"4093","a":"2025","e":"Dispõe sobre a inversão do ônus da prova em demandas judiciais relativas à saúde e dá outras providências.","d":"2025-08-19","s":"Aguardando Parecer","autor_principal":true},{"id":"2543140","tp":"PL","n":"3958","a":"2025","e":"Cria o Programa Nacional de Busca Ativa de Genitores – PNBAG, voltado a auxiliar pessoas adultas que desconhecem seus pais ou mães biológicos na localização e eventual reconhecimento voluntário de filiação, e dá outras providências","d":"2025-08-12","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2531525","tp":"PL","n":"3214","a":"2025","e":"Institui o Programa de Avaliação Geriátrica Ampla e Periódica para Pessoas Idosas no âmbito nacional.","d":"2025-07-02","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2512039","tp":"PL","n":"2392","a":"2025","e":"Institui a Política de Expansão da Telessaúde no âmbito dos Estados e Municípios, dispõe sobre a criação da Base Nacional de Telemedicina e Telessaúde pela União, e altera o art. 26-A da Lei nº 8.080, de 19 de setembro de 1990.","d":"2025-05-20","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2498480","tp":"PL","n":"1761","a":"2025","e":"Dispõe sobre a obrigatoriedade do acompanhamento psicológico pós-parto nas unidades de saúde públicas e privadas, visando à promoção da saúde mental materna no período do puerpério.","d":"2025-04-22","s":"Pronta para Pauta","autor_principal":true},{"id":"2495650","tp":"PL","n":"1572","a":"2025","e":"Institui o Dia Nacional do Assessor Parlamentar.","d":"2025-04-08","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2495647","tp":"PL","n":"1571","a":"2025","e":"Altera a Lei nº 14.238, de 19 de novembro de 2021, para dispor sobre o envio obrigatório de expediente ao juízo competente para análise jurisdicional, no prazo de 48 (quarenta e oito) horas, quando houver judicialização de pedido por paciente portador de câncer, bem como dispõe sobre o processo judicial relacionado à efetivação dos direitos da pessoa portadora de câncer.","d":"2025-04-08","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2490478","tp":"PL","n":"1281","a":"2025","e":"Dispõe sobre a criação de um Centro de Referência em Lipedema, objetivando oferecer acompanhamento especializado e outras condições similares.","d":"2025-03-27","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2488139","tp":"PL","n":"1155","a":"2025","e":"Cria obrigatoriedade de assentos com espaço ampliado para passageiros altos e obesos em voos nacionais.","d":"2025-03-20","s":"Aguardando Parecer","autor_principal":true},{"id":"2487390","tp":"PEC","n":"11","a":"2025","e":"Dá nova redação ao art. 71 da Constituição Federal, para alterar a prerrogativa de controle externo, a cargo do Congresso Nacional, com auxílio do Tribunal de Contas da União, no que se refere às contas nacionais das empresas supranacionais de cujo capital social a União participe, de forma direta ou indireta.","d":"2025-03-18","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2486443","tp":"PL","n":"883","a":"2025","e":"Dispõe sobre os direitos dos passageiros em casos de reacomodação em classe inferior (downgrade) em voos comerciais no Brasil e define outras providências. (Lei Ingrid Guimarães).","d":"2025-03-11","s":"Aguardando Parecer","autor_principal":true},{"id":"2485623","tp":"PL","n":"720","a":"2025","e":"Cria mecanismos de Proteção às Mulheres vítimas de violência doméstica, alterando o Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal), e a Lei nº 11.340, de 7 de agosto de 2006 (Lei Maria da Penha) para criar exclusão de ilicitude a quem comunicar à mulher informações relevantes para a sua segurança e integridade física e emocional.","d":"2025-02-26","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2484002","tp":"PL","n":"461","a":"2025","e":"Altera o inciso IV do §5º do art. 171 do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 (Código Penal Brasileiro), para reduzir de 70 para 60 anos a idade a partir da qual se aplica o acréscimo de pena de 1/3 (um terço) ao dobro, quando o crime de estelionato for cometido contra idoso ou vulnerável","d":"2025-02-13","s":"Pronta para Pauta","autor_principal":true},{"id":"2483164","tp":"PEC","n":"2","a":"2025","e":"Dá nova redação ao Capítulo II, do Título IV, da Constituição Federal, que dispõe sobre o Poder Executivo e dá outras providências.","d":"2025-02-06","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2483087","tp":"PL","n":"301","a":"2025","e":"Altera a Lei nº 11.788, de 25 de setembro de 2008, para prever a suspensão do estágio para a estagiária gestante.","d":"2025-02-05","s":"Aguardando Designação de Relator(a)","autor_principal":true},{"id":"2478427","tp":"PEC","n":"48","a":"2024","e":"Altera o art. 53 da Constituição Federal para deixar explícito que a imunidade material de Deputados e Senadores se aplica independentemente do local em que forem proferidas opiniões, palavras e votos, e para determinar ao Ministro do Supremo Tribunal Federal que, no exercício de suas funções, contrariar esta disposição, a pena de perda do cargo, sem vencimentos e com inabilitação, por até cinco a","d":"2024-12-11","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2471383","tp":"PEC","n":"44","a":"2024","e":"Altera o §9º do artigo 166 da Constituição Federal para destinar parte dos recursos oriundos das emendas individuais a programas e ações relacionados ao Esporte.","d":"2024-11-26","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2470878","tp":"PL","n":"4477","a":"2024","e":"Altera a Lei nº 11.788, de 25 de setembro de 2008, que Dispõe sobre o Estágio de Estudantes em todo o território nacional.","d":"2024-11-21","s":"Aguardando Designação - Aguardando Devolução de Relator(a) que deixou de ser Membro","autor_principal":true},{"id":"2470874","tp":"PL","n":"4475","a":"2024","e":"Cria o Estatuto da Pessoa com Autismo.","d":"2024-11-21","s":"Notificações","autor_principal":true},{"id":"2467670","tp":"PEC","n":"42","a":"2024","e":"Acrescenta o inciso VI ao art. 51 da Constituição Federal, para estabelecer competência privativa à Câmara dos Deputados relativa à fiscalização das atividades das agências reguladoras.","d":"2024-11-11","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2463147","tp":"PL","n":"4001","a":"2024","e":"Institui a obrigatoriedade de criação de canais de atendimento de   emergência pelas concessionárias de serviços de energia elétrica.","d":"2024-10-17","s":"Pronta para Pauta","autor_principal":true},{"id":"2458742","tp":"PEC","n":"34","a":"2024","e":"Inclui a primeira infância como beneficiária de direitos e garantias, no Texto Constitucional.","d":"2024-09-19","s":"Apresentação de Requerimento","autor_principal":false},{"id":"2448752","tp":"PEC","n":"29","a":"2024","e":"Altera a Constituição Federal para acrescentar no art. 5º texto sobre o marco temporal de início da vida humana explicitando de forma inequívoca a inviolabilidade do direito à vida, desde a sua concepção, bem como cria o inciso LXXX para especificar que a concepção é a junção do gameta masculino e o feminino, ocorrida durante a fecundação, em local propício para o desenvolvimento celular.","d":"2024-07-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2442880","tp":"PEC","n":"24","a":"2024","e":"Altera os §§ 4º, 4°-B e 7º do art. 40 da Constituição Federal e os artigos 5º, 10, 23, 24 e 26 da Emenda Constitucional nº 103, de 2019, acrescenta o art. 144-A a Constituição e dá outras providências.","d":"2024-06-24","s":"Aguardando Constituição de Comissão Temporária","autor_principal":false},{"id":"2436224","tp":"PEC","n":"21","a":"2024","e":"Altera o art. 198 da Constituição Federal, para promover o enquadramento dos servidores públicos federais ocupantes do cargo de auxiliar de enfermagem para a carreira dos técnicos de enfermagem.","d":"2024-05-23","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2434493","tp":"PL","n":"1904","a":"2024","e":"Acresce dois parágrafos ao art. 124, um parágrafo único ao artigo 125, um segundo parágrafo ao artigo 126 e um parágrafo único ao artigo 128, todos do Código Penal Brasileiro, e dá outras providências.","d":"2024-05-17","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2432970","tp":"PL","n":"1768","a":"2024","e":"Dispõe sobre o auxílio entre Estados e Municípios afetados por catástrofes naturais e outros eventos de força maior.","d":"2024-05-13","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2422761","tp":"PL","n":"921","a":"2024","e":"Altera a Lei nº 14.254, de 30 de novembro de 2021, que dispõe sobre o acompanhamento integral para educandos com dislexia ou Transtorno do Deficit de Atenção com Hiperatividade (TDAH) ou outro transtorno de aprendizagem.","d":"2024-03-21","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2417499","tp":"PL","n":"186","a":"2024","e":"Altera a Lei nº 12.764, de 27 de dezembro de 2021, que institui a Política Nacional de Proteção dos Direitos da Pessoa com Transtorno do Espectro Autista, objetivando ampliar o rol de instituições punidas que recusar matrícula.","d":"2024-02-07","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2416999","tp":"PL","n":"67","a":"2024","e":"Proíbe a divulgação de conversas não autorizadas por WhatsApp, Telegram e outros aplicativos sem autorização dos participantes, que seja denominada “Lei Jessica Vitória”.","d":"2024-02-05","s":"Aguardando Designação - Aguardando Devolução de Relator(a) que deixou de ser Membro","autor_principal":true},{"id":"2407484","tp":"PL","n":"5756","a":"2023","e":"Altera o Decreto-Lei nº 5.452, de 1º de maio de 1943 (aprova a Consolidação das Leis do Trabalho - CLT), criando o vestiário feminino para empresas acima de 50 (cinquenta) funcionários para resguardar a privacidade e bem-estar das Mulheres.","d":"2023-11-28","s":"Pronta para Pauta","autor_principal":true},{"id":"2402861","tp":"PEC","n":"57","a":"2023","e":"Altera os arts. 40 e 144 da Constituição Federal para dispor sobre as Polícias Municipais.","d":"2023-11-08","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2400870","tp":"PL","n":"5296","a":"2023","e":"Dispõe sobre a inclusão de profissionais de psicologia no quadro funcional dos estabelecimentos de educação básica de todo o país.","d":"2023-11-01","s":"Tramitando em Conjunto","autor_principal":true},{"id":"2383822","tp":"PL","n":"4213","a":"2023","e":"Dispõe sobre a obrigação para que todos os estab