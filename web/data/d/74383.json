{"id":74383,"nome":"Giacobo","partido":"PSD","uf":"PR","foto":"https://www.camara.leg.br/internet/deputado/bandep/74383.jpg","inicio":"2023-02-01","fim":"2026-05-05","meses":40,"em_exercicio":false,"periodos":[["2023-02-01","2026-05-05"]],"ideologia":{"nota":7.09,"faixa":"direita","campo":"direita","estimado":false,"obs":""},"ideologia_voto":{"nota":8.61,"faixa":"extrema-direita","campo":"direita","n":78},"candidatura":null,"candidatura_substituida":null,"partido_voto":{"nota":5.05,"faixa":"centro","n":54,"q1":4.23,"q3":5.81},"propostas":{"contagem":{"REQ":221,"PEC":19,"EMC":19,"RCP":6,"EMP":5,"PL":4,"DOC":4,"PDL":2,"PLP":2,"RRL":1,"SBT":1,"PRL":1,"REC":1,"RDF":1},"lista":[{"id":"2567768","tp":"PDL","n":"800","a":"2025","e":"Susta os efeitos da Consulta Pública Processo: 50000.034372/2025-74 de 02/10/2025, emitida pela Secretaria de Nacional de Trânsito – SENATRAN, que trata de Minuta de Resolução que “normatiza os procedimentos sobre a aprendizagem, habilitação e expedição de documentos de condutores e o processo de formação do candidato à obtenção da Carteira Nacional de Habilitação ou da Autorização para Conduzir C","d":"2025-10-07","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Autorização)","autor_principal":false},{"id":"2563273","tp":"PEC","n":"35","a":"2025","e":"Altera a Constituição Federal para acrescentar os §§ 4º e 5º ao art. 164 para determinar que a criação, emissão e circulação de qualquer moeda digital do Banco Central (CBDC) ou outro ativo digital requer aprovação das duas Casas do Congresso Nacional, bem como para determinar que a extinção do papel-moeda forçada no território nacional é vedada, salvo se aprovada em cada uma das duas Casas do Con","d":"2025-09-23","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2557024","tp":"PEC","n":"34","a":"2025","e":"Acrescenta o inciso IX ao art. 225, §º1 da Constituição Federal, a alínea “e” ao inciso II do art. 9º, §3º e o §14 ao art. 9º da Emenda Constitucional 132/2023 para corrigir o tratamento injusto concedido pela Reforma Tributária aos agentes que atuam no setor de reciclagem, desvalorizando os materiais recicláveis e desincentivando a economia circular.","d":"2025-09-03","s":"Aguardando Constituição de Comissão Temporária","autor_principal":false},{"id":"2551011","tp":"PEC","n":"32","a":"2025","e":"Esta Lei altera o artigo 5º, inciso XLIII, da Constituição Federal, o qual prevê que nos casos de crimes previstos neste inciso, a pena deverá ser cumprida integralmente em regime fechado, por eles respondendo os mandantes, os executores e os que, podendo evitá-los, se omitirem, e dá outras providências.","d":"2025-08-20","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2508216","tp":"PL","n":"2265","a":"2025","e":"Revoga os arts. 359-L e 359-M do Decreto-Lei nº 2.848, de 7 de dezembro de 1940 – Código Penal Brasileiro.","d":"2025-05-13","s":"Arquivada","autor_principal":false},{"id":"2504516","tp":"PEC","n":"21","a":"2025","e":"Acrescenta o inciso LXXX ao artigo 5º da Constituição Federal para tornar imprescritível os crimes sexuais quando cometidos contra menores de doze anos de idade.","d":"2025-05-06","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2499794","tp":"PEC","n":"17","a":"2025","e":"Acrescenta os §§ 11, 12 e 13 ao art. 144 da Constituição Federal, para instituir o piso salarial dos servidores policiais civis e militares e bombeiros militares.","d":"2025-04-23","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2485767","tp":"PEC","n":"9","a":"2025","e":"Acrescenta o § 16 ao art. 198 da Constituição Federal, para dispor sobre as diretrizes para os Planos de Carreira e os pisos salariais nacionais dos profissionais de saúde do Sistema Único de Saúde.","d":"2025-02-27","s":"Aguardando Parecer","autor_principal":false},{"id":"2479738","tp":"PEC","n":"51","a":"2024","e":"Altera o art. 7º e o Ato das Disposições Constitucionais Transitórias da Constituição Federal de 1988, para dispor sobre as condições especiais de trabalho do motorista profissional empregado no transporte rodoviário de cargas e de passageiros.","d":"2024-12-12","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2448752","tp":"PEC","n":"29","a":"2024","e":"Altera a Constituição Federal para acrescentar no art. 5º texto sobre o marco temporal de início da vida humana explicitando de forma inequívoca a inviolabilidade do direito à vida, desde a sua concepção, bem como cria o inciso LXXX para especificar que a concepção é a junção do gameta masculino e o feminino, ocorrida durante a fecundação, em local propício para o desenvolvimento celular.","d":"2024-07-10","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2448732","tp":"PEC","n":"28","a":"2024","e":"Acrescenta o art. 97-A e §§4º e 5º da Constituição Federal de 1988, para estabelecer o julgamento de referendo de liminares pelo colegiado de Tribunal, bem como criar hipótese de sustação de decisão do Supremo Tribunal Federal.","d":"2024-07-10","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2442880","tp":"PEC","n":"24","a":"2024","e":"Altera os §§ 4º, 4°-B e 7º do art. 40 da Constituição Federal e os artigos 5º, 10, 23, 24 e 26 da Emenda Constitucional nº 103, de 2019, acrescenta o art. 144-A a Constituição e dá outras providências.","d":"2024-06-24","s":"Aguardando Constituição de Comissão Temporária","autor_principal":false},{"id":"2436529","tp":"PL","n":"2058","a":"2024","e":"Cria a Lei de Criminalização do Revenge Porn e Sextorsão.","d":"2024-05-27","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2423486","tp":"PLP","n":"35","a":"2024","e":"Institui a Cesta Básica Nacional de Alimentos - CeNA criada pelo artigo 8º da Emenda Constitucional nº 132, de 20 de dezembro de 2023.","d":"2024-03-26","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2420536","tp":"PL","n":"719","a":"2024","e":"Dispõe sobre a prorrogação do prazo de incentivos da Política Industrial Para o Setor de Tecnologias da Informação e Comunicação e para o Setor de Semicondutores, estabelecida pelas Leis nº 11.484, de 31 de maio de 2007 e Lei nº 8.248, de 23 de outubro de 1991, com as alterações da Lei nº 13.969, de 26 de dezembro de 2019.","d":"2024-03-12","s":"Arquivada","autor_principal":false},{"id":"2402861","tp":"PEC","n":"57","a":"2023","e":"Altera os arts. 40 e 144 da Constituição Federal para dispor sobre as Polícias Municipais.","d":"2023-11-08","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2401109","tp":"PDL","n":"392","a":"2023","e":"Susta o Decreto nº 11.764, de 31 de outubro de 2023, que altera a Tabela de Incidência do Imposto sobre Produtos Industrializados - TIPI, aprovada pelo Decreto nº 11.158, de 29 de julho de 2022.","d":"2023-11-01","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2391567","tp":"PEC","n":"50","a":"2023","e":"Altera o art. 49 da Constituição Federal para estabelecer competência ao Congresso Nacional para sustar, por maioria qualificada dos membros da Câmara dos Deputados e do Senado Federal, decisão do Supremo Tribunal Federal transitada em julgado, que extrapole os limites constitucionais.","d":"2023-09-27","s":"Aguardando Criação de Comissão Temporária","autor_principal":false},{"id":"2388029","tp":"PEC","n":"44","a":"2023","e":"Adiciona-se parágrafo 9ºB ao artigo 166 da Constituição Federal para permitir o emendamento em reserva, de 5% para o uso em catástrofes e emergências naturais.\n\n\n\r\n\r\nNOVA EMENTA: Altera o art. 166 da Constituição Federal e acrescenta o art. 138 no Ato das Disposições Constitucionais Transitórias, para destinar parte dos recursos das emendas individuais e de bancadas estaduais e do orçamento da Uni","d":"2023-09-14","s":"Aguardando Apreciação pelo Senado Federal","autor_principal":false},{"id":"2380340","tp":"PEC","n":"38","a":"2023","e":"Modifica as regras dos regimes próprios de previdência social dos servidores dos municípios, objetivando o equilíbrio financeiro e atuarial dos regimes e a sustentabilidade fiscal desses entes, e dá outras providências.","d":"2023-08-16","s":"Aguardando Designação - Aguardando Devolução de Relator(a) que deixou de ser Membro","autor_principal":false},{"id":"2372482","tp":"PLP","n":"141","a":"2023","e":"Altera o inciso XIV do artigo 22, da Lei Complementar nº 64, de 18 de maio de 1990, para determinar que a sanção de inelegibilidade para as eleições a se realizarem seja nos 2 (dois) anos subsequentes à eleição.","d":"2023-07-04","s":"Tramitando em Conjunto","autor_principal":false},{"id":"2363434","tp":"PEC","n":"27","a":"2023","e":"Altera o art. 159 da Constituição Federal para disciplinar a distribuição de recursos pela União ao Fundo de Participação dos Municípios, criar os Fundos Constitucionais de financiamento das Regiões Sul e Sudeste, e dá outras providências.","d":"2023-05-18","s":"Designação de Relator(a)","autor_principal":false},{"id":"2355858","tp":"PL","n":"1815","a":"2023","e":"Altera o Código Eleitoral e institui o Programa Cidadania Plena, orientado a facilitar o alistamento, a transferência e votação de idosos, pessoas hospitalizadas e com mobilidade reduzida e de cidadãos das comunidades quilombolas, das comunidades caiçaras e ribeirinhas e das aldeias indígenas.","d":"2023-04-12","s":"Aguardando Designação de Relator(a)","autor_principal":false},{"id":"2351680","tp":"PEC","n":"7","a":"2023","e":"Altera o art. 84, XII, da Constituição Federal de 1988, para estabelecer parâmetro para a concessão de indulto e comutação de penas pelo Presidente da República.","d":"2023-03-16","s":"Aguardando Despacho do Presidente da Câmara dos Deputados (Chancela)","autor_principal":false},{"id":"2351620","tp":"PEC","n":"6","a":"2023","e":"Dispõe sobr